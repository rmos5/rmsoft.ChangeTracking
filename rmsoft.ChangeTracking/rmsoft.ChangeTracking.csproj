<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>rmsoft.ChangeTracking</AssemblyName>
    <RootNamespace>rmsoft.ChangeTracking</RootNamespace>
    <Description>Change tracking helpers for .NET objects and observable collections.</Description>
    <Authors>raivo.mosona@gmail.com</Authors>
    <Company>rmsoft</Company>
    <Product>rmsoft.ChangeTracking</Product>
    <Copyright>Copyright (c) 2019-2026 rmsoft</Copyright>
    <PackageId>rmsoft.ChangeTracking</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial stable release. Tracks outstanding changes relative to the baseline captured by StartTracking().</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/rmos5/rmsoft.ChangeTracking</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rmos5/rmsoft.ChangeTracking</PackageProjectUrl>
    <PackageTags>change-tracking;undo;redo;observablecollection;inotifypropertychanged</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
